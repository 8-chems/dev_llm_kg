# Environment configuration example
ENV=dev
PIPELINE_MODE=shadow

# Jev SDK
TYPESAFE_API_KEY=ts_test_key_sample
JEV_MODEL=jev-1.13
JEV_TIMEOUT_S=2.0
JEV_BASE_URL=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Anthropic LLM
ANTHROPIC_API_KEY=sk-ant-test-key
LLM_MODEL_PARSE=claude-haiku-4-5-20251001
LLM_MODEL_REVIEW=claude-opus-5-5
LLM_MODEL_NARRATE=claude-sonnet-5-5

# Pipeline Settings
MAX_CANDIDATES=50
MAX_EDGES=50
MAX_HOPS=3
THRESHOLDS_PATH=eval/thresholds/thresholds.json

# GCP Infra
GCP_PROJECT=dev-graphrag-gcp
PUBSUB_TOPIC=escalations
BQ_DATASET=decisions
